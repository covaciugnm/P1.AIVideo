# =============================================================================
# P1.AIVideo — example environment file
# Copy to `.env` and edit. Do NOT commit `.env`.
# =============================================================================

# --- Runtime ---
APP_ENV=development              # development | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
TZ=UTC

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000
JWT_SECRET=changeme-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRY_MIN=60

# --- Frontend (Next.js) ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aivideo
POSTGRES_USER=aivideo
POSTGRES_PASSWORD=changeme

# --- Redis (queue + cache) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Queue topics (Redis Streams) ---
# Messages on these streams carry artifact references (MinIO URIs, IDs, hashes),
# never raw media. See docs/architecture/data-flow.md.
QUEUE_TOPIC_SCRIPTWRITER=stage.scriptwriter
QUEUE_TOPIC_VOICE=stage.voice
QUEUE_TOPIC_FACE=stage.face
QUEUE_TOPIC_LIPSYNC=stage.lipsync
QUEUE_TOPIC_RENDER=stage.render
QUEUE_TOPIC_QC=stage.qc
QUEUE_TOPIC_COMPLIANCE=stage.compliance
QUEUE_TOPIC_AUDIT=audit.compliance
QUEUE_TOPIC_PUBLISHER=stage.publisher

# --- MinIO (object storage) ---
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=aivideo
MINIO_ROOT_PASSWORD=changeme-please
MINIO_BUCKET_JOBS=aivideo-jobs
MINIO_BUCKET_MODELS=aivideo-models
MINIO_USE_SSL=false

# =============================================================================
# Model backends — adapter pattern; orchestrator never imports providers directly
# =============================================================================

# --- LLM (Scriptwriter) ---
# Phase 3G: provider registry + contract only. NO real LLM calls happen
# unless SCRIPTWRITER_ENABLE_NETWORK_CALLS=true AND a real backend has
# been activated in a later phase. The default `template` backend is
# deterministic and dependency-free.
SCRIPTWRITER_BACKEND=template
SCRIPTWRITER_MODEL=qwen3.6
SCRIPTWRITER_FALLBACK_MODEL=qwen3:8b
SCRIPTWRITER_ALLOWED_BACKENDS=template,mock,ollama,vllm,openai_compatible,openai,anthropic,local_http
SCRIPTWRITER_ENABLE_NETWORK_CALLS=false
SCRIPTWRITER_TIMEOUT_SECONDS=60
SCRIPTWRITER_MAX_OUTPUT_TOKENS=800
SCRIPTWRITER_TEMPERATURE=0.7
SCRIPTWRITER_PROMPT_VERSION=v1

# Per-provider stubs (configured but inactive until a future phase).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.6
OLLAMA_FALLBACK_MODEL=qwen3:8b

VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=qwen3.6
VLLM_FALLBACK_MODEL=qwen3:8b

OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=60

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=60

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_TIMEOUT_SECONDS=60

LOCAL_LLM_URL=
LOCAL_LLM_MODEL=qwen3.6
LOCAL_LLM_TIMEOUT_SECONDS=60

# Optional model-registry overrides. Tests + future operators can point
# at a YAML that declares additional models without code changes. The
# `.example.yaml` ships as the documented schema; copy + edit per
# deployment.
LLM_MODEL_REGISTRY_JSON=
LLM_PROVIDER_CONFIG_PATH=configs/llm/providers.example.yaml

# Legacy aliases kept for back-compat with earlier docs.
LLM_BACKEND=vllm
LLM_MODEL_ID=qwen3.6
LLM_ENDPOINT=http://model-llm:8000/v1
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7

# --- Voice mode + provided audio (Phase 3C) ---
# Comma-separated list of directories from which operator-supplied .wav
# files may be referenced via voice_mode="provided_audio". Paths submitted
# to the API are normalised and must resolve under one of these roots; any
# `..` traversal or non-.wav extension is rejected at validation time.
PROVIDED_AUDIO_ALLOWED_ROOTS=/workspace/assets/input/audio,/storage/inputs/audio,/app/assets/input/audio

# --- Audio validation + artifacts (Phase 3D) ---
# Maximum file size (in bytes) for a provided-audio WAV. 50 MB by default.
AUDIO_MAX_FILE_SIZE_BYTES=52428800
# Optional sample-rate / channel allowlists. Empty values mean "accept
# anything the stdlib `wave` module can parse"; comma-separated integers
# to restrict, e.g. AUDIO_ALLOWED_SAMPLE_RATES=22050,48000
AUDIO_ALLOWED_SAMPLE_RATES=
AUDIO_ALLOWED_CHANNELS=
# Local artifact root. Reserved for a future per-job working directory
# layout; Phase 3D doesn't yet copy provided audio out of its allowed root.
ARTIFACTS_LOCAL_ROOT=/storage/artifacts

# --- Provided face image (Phase 3E) ---
# Comma-separated list of directories operators may reference via
# face_mode="provided_image". Same path-safety rules as audio.
PROVIDED_IMAGE_ALLOWED_ROOTS=/workspace/assets/input/images,/storage/inputs/images,/app/assets/input/images
# Maximum file size for a provided image. 10 MB by default.
IMAGE_MAX_FILE_SIZE_BYTES=10485760
# Optional minimum dimensions. Empty values = no minimum enforced.
IMAGE_MIN_WIDTH=
IMAGE_MIN_HEIGHT=

# --- Upload intake (Phase 4A-2) ---
# Where the upload endpoints save files. Each subroot must be reachable
# under one of PROVIDED_AUDIO_ALLOWED_ROOTS / PROVIDED_IMAGE_ALLOWED_ROOTS
# so the existing path-safety validator accepts the file when the
# subsequent POST /api/v1/jobs/from-inputs references it. Prefer absolute
# paths in production.
UPLOADS_LOCAL_ROOT=storage/inputs
UPLOAD_AUDIO_ROOT=storage/inputs/audio
UPLOAD_IMAGE_ROOT=storage/inputs/images
UPLOAD_TEXT_ROOT=storage/inputs/text
SCRIPT_TEXT_MAX_CHARS=8000


# --- TTS (Voice) ---
TTS_BACKEND=piper                # piper | xtts (synthetic voices only — no cloning)
TTS_MODELS_ROOT=/models/tts                      # top-level TTS model root
PIPER_MODELS_ROOT=/models/tts/piper              # Piper-specific subdir (Phase 3A+)
# Legacy alias kept for back-compat; new code reads TTS_MODELS_ROOT.
TTS_VOICES_DIR=/models/tts
TTS_DEFAULT_VOICE=en_US-amy-medium
TTS_SAMPLE_RATE=48000

# --- Face generation ---
FACE_BACKEND=sdxl
SDXL_CHECKPOINTS_DIR=/models/image/sdxl
PERSONA_LORA_PATH=/models/image/loras/persona_caucasian_v1.safetensors
FACE_NEGATIVE_PROMPT="real person, celebrity, photograph of real human, identifiable likeness"

# --- Lip-sync (adapter pattern) ---
LIPSYNC_BACKEND=sadtalker                            # sadtalker (default) | musetalk (v2) | wav2lip (fallback)
LIPSYNC_MODELS_ROOT=/models/lipsync                  # top-level lip-sync model root
SADTALKER_MODELS_ROOT=/models/lipsync/sadtalker      # SadTalker-specific subdir (Phase 3A+)
# Legacy aliases kept for back-compat; new code reads SADTALKER_MODELS_ROOT.
SADTALKER_CHECKPOINTS_DIR=/models/lipsync/sadtalker/checkpoints
SADTALKER_GFPGAN_DIR=/models/lipsync/sadtalker/gfpgan
MUSETALK_CHECKPOINTS_DIR=/models/lipsync/musetalk    # placeholder; provider not implemented
WAV2LIP_CHECKPOINTS_DIR=/models/lipsync/wav2lip      # placeholder; provider not implemented

# --- Speech alignment / subtitles ---
WHISPER_BACKEND=whisperx
WHISPER_MODEL=large-v3
WHISPER_MODELS_DIR=/models/whisper

# =============================================================================
# Safety & compliance — DO NOT relax these without a compliance review
# =============================================================================

# Never silently fetch model weights at runtime. Override only if you accept the risk.
ALLOW_MODEL_AUTODOWNLOAD=false

# Mandatory output disclosure
DISCLOSURE_OVERLAY_ENABLED=true
DISCLOSURE_OVERLAY_TEXT="AI-generated"
DISCLOSURE_OVERLAY_POSITION=bottom_left
DISCLOSURE_OVERLAY_MIN_HEIGHT_PCT=4
DISCLOSURE_C2PA_ENABLED=true
DISCLOSURE_XMP_ENABLED=true

# Identity guard — reject outputs that resemble real public figures
IDENTITY_GUARD_ENABLED=true
IDENTITY_GUARD_INDEX_PATH=/models/identity_guard/public_figures.index
IDENTITY_GUARD_THRESHOLD=0.85

# Banned topics & policy classifier
# Path to the active banned-topics ruleset. Relative paths resolve against
# the repo root. Falls back to configs/policies/banned_topics.example.yaml
# if unset and no banned_topics.yaml exists.
BANNED_TOPICS_PATH=configs/policies/banned_topics.example.yaml
POLICY_RULES_PATH=/configs/policies/banned_topics.yaml
POLICY_CLASSIFIER_BACKEND=local

# Compliance-token signing (Phase 2: HMAC; Phase 5+ may swap to JWT/RSA).
# Generate with: openssl rand -hex 32
COMPLIANCE_SIGNING_KEY=changeme-generate-with-openssl-rand-hex-32
COMPLIANCE_TOKEN_TTL_SECONDS=3600
ALLOWED_LIPSYNC_BACKEND=sadtalker

# Synthetic-person enforcement
REQUIRE_SYNTHETIC_PERSON_FLAG=true
ALLOW_BYO_LIKENESS=false         # locked OFF in v1; would require a consent module

# Voice cloning guard — cloning code paths are stripped at build time
ALLOW_VOICE_CLONING=false

# --- C2PA signing ---
C2PA_SIGNING_CERT_PATH=/configs/c2pa/signer.crt
C2PA_SIGNING_KEY_PATH=/configs/c2pa/signer.key
C2PA_PRODUCER_NAME="P1.AIVideo"

# =============================================================================
# Reel duration bounds
# =============================================================================
TARGET_DURATION_SECONDS=30
MIN_REEL_DURATION_SECONDS=15
MAX_REEL_DURATION_SECONDS=60

# =============================================================================
# Storage retention
# =============================================================================
JOB_ARTIFACT_TTL_DAYS=30
AUDIT_LOG_RETENTION_DAYS=365

# =============================================================================
# Observability
# =============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# =============================================================================
# GPU
# =============================================================================
# Comma-separated GPU indices visible to GPU-enabled containers (e.g., "0" or "0,1").
NVIDIA_VISIBLE_DEVICES=0
NVIDIA_DRIVER_CAPABILITIES=compute,utility,video
