# Python virtualenvs + tooling caches
.venv/
venv/
.env
.envrc
.python-version
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/*.egg-info/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/
.tox/

# Node / Next
**/node_modules/
**/.next/
**/.turbo/
**/.npm/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Git + CI scaffolding
.git/
.github/
.gitignore
.gitattributes

# Local runtime state we never want baked into images
storage/
logs/
tmp/

# Model weights — never baked into images
models/
*.onnx
*.safetensors
*.pt
*.pth
*.ckpt
*.bin
*.gguf

# Sample / fixture media
*.mp4
*.mov
*.webm
*.wav
*.mp3
*.flac
*.png
*.jpg
*.jpeg
*.webp
!frontend/public/**

# Editor + OS junk
.vscode/
.idea/
.DS_Store
Thumbs.db

# Audit / one-off helpers
.audit-tmp/

# Docs are not needed at runtime; keep small image
docs/
