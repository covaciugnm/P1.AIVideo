{
  "_comment": "P1.AIVideo — SDXL initial (text-to-image) workflow template. Plain txt2img used to PROPOSE candidate faces for a brand-new character (no identity reference exists yet). Placeholders: __PROMPT__ __NEGATIVE__ __SEED__ __WIDTH__ __HEIGHT__ __STEPS__ __CFG__. Requires a base SDXL checkpoint at COMFYUI models/checkpoints (see README).",
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "sdxl-base-1.0/sd_xl_base_1.0.safetensors" }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": __WIDTH__, "height": __HEIGHT__, "batch_size": 1 }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "__PROMPT__", "clip": ["4", 1] }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "__NEGATIVE__", "clip": ["4", 1] }
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": __SEED__,
      "steps": __STEPS__,
      "cfg": __CFG__,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": ["4", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["3", 0], "vae": ["4", 2] }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "p1aivideo_initial", "images": ["8", 0] }
  }
}
