{
  "_comment": "P1.AIVideo — PuLID-FLUX identity-consistent workflow (PRIMARY provider, high quality, heavy VRAM → 128GB box). Conditions FLUX.1-dev on the canonical FACE reference (__FACE_REF__) via PuLID. Node class names follow balazik/cubiq ComfyUI_PuLID_Flux — adjust to your installed nodes (see README). Placeholders: __PROMPT__ __NEGATIVE__ __SEED__ __WIDTH__ __HEIGHT__ __STEPS__ __CFG__ __FACE_REF__.",
  "20": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "flux1-dev.safetensors", "weight_dtype": "fp8_e4m3fn" }
  },
  "21": {
    "class_type": "DualCLIPLoader",
    "inputs": { "clip_name1": "t5xxl_fp8_e4m3fn.safetensors", "clip_name2": "clip_l.safetensors", "type": "flux" }
  },
  "22": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "ae.safetensors" }
  },
  "10": {
    "class_type": "LoadImage",
    "inputs": { "image": "__FACE_REF__" }
  },
  "23": {
    "class_type": "PulidFluxModelLoader",
    "inputs": { "pulid_file": "pulid_flux_v0.9.1.safetensors" }
  },
  "24": {
    "class_type": "PulidFluxInsightFaceLoader",
    "inputs": { "provider": "CPU" }
  },
  "25": {
    "class_type": "PulidFluxEvaClipLoader",
    "inputs": {}
  },
  "26": {
    "class_type": "ApplyPulidFlux",
    "inputs": {
      "weight": 0.9,
      "start_at": 0.0,
      "end_at": 1.0,
      "model": ["20", 0],
      "pulid_flux": ["23", 0],
      "eva_clip": ["25", 0],
      "face_analysis": ["24", 0],
      "image": ["10", 0]
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "__PROMPT__", "clip": ["21", 0] }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "__NEGATIVE__", "clip": ["21", 0] }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": __WIDTH__, "height": __HEIGHT__, "batch_size": 1 }
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": __SEED__,
      "steps": __STEPS__,
      "cfg": __CFG__,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["26", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["3", 0], "vae": ["22", 0] }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "p1aivideo_consistent", "images": ["8", 0] }
  }
}
